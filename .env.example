# Clerk (auth) — https://dashboard.clerk.com
# Local: use test keys (pk_test_… / sk_test_…). Production on Vercel: use live keys (pk_live_… / sk_live_…).
# See CLERK_DEPLOYMENT.md for environment separation and deploy checklist.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Admin access — comma-separated emails that can access the Admin panel
VITE_ADMIN_EMAILS=admin@alo-tech.com

# Postgres (Vercel / server) — used by API routes and server-side code
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
